# EC2 docker compose 환경 변수. `cp .env.example .env` 후 채운다. .env는 커밋하지 않는다
# 비밀값 만들기: openssl rand -base64 32

# HTTPS로 서비스할 도메인. A 레코드가 EC2 Elastic IP를 가리켜야 한다
API_DOMAIN=api.example.com

# AI_worker 저장소 위치 (이 폴더 기준). 두 저장소를 같은 폴더에 나란히 clone했으면 그대로
AI_DIR=../../../AI_worker

# Postgres. Railway DB와 같은 메이저 버전 (Railway에서 SELECT version();)
POSTGRES_IMAGE=postgres:16
POSTGRES_PASSWORD=

# Railway 백엔드 서비스와 같은 값 (다르면 옮긴 회원의 휴대폰 번호·로그인 유지가 깨진다)
PHONE_AES_KEY=
PHONE_HMAC_KEY=
REMEMBER_ME_KEY=

# Spring ↔ AI 내부 토큰 (X-Internal-Token). 새로 만들어도 된다
AI_INTERNAL_TOKEN=

# AI
OPENAI_API_KEY=
IMAGE_CONCURRENCY=3
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# 그림 버킷 (Railway와 같은 버킷). 접근 키는 넣지 않는다 — EC2 IAM 역할
S3_BUCKET=
S3_REGION=ap-northeast-2

# dev: Swagger 켬, 인증번호 000000, 문자는 로그만. prod는 문자 발송 구현 전이라 못 뜬다
SPRING_PROFILES_ACTIVE=dev
