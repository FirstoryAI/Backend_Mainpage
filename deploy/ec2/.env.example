# EC2 docker compose 환경 변수. `cp .env.example .env` 후 채운다. .env는 커밋하지 않는다
# 비밀값 만들기: openssl rand -base64 32

# HTTPS로 서비스할 도메인. A 레코드가 EC2 Elastic IP를 가리켜야 한다
API_DOMAIN=api.example.com

# AI_worker 저장소 위치 (이 폴더 기준). 두 저장소를 같은 폴더에 나란히 clone했으면 그대로
AI_DIR=../../../AI_worker

# Postgres. Railway DB와 같은 메이저 버전 (Railway에서 SELECT version(); 11/2 기준 18.6)
# 16 이하로 바꾸면 docker-compose.yml의 볼륨 경로도 /var/lib/postgresql/data로 바꾼다
POSTGRES_IMAGE=postgres:18
POSTGRES_PASSWORD=

# Railway 백엔드 서비스와 같은 값 (다르면 로그인 유지가 깨진다)
REMEMBER_ME_KEY=

# 인증번호·알림 메일 (팀 Gmail). PASSWORD는 Google 계정 2단계 인증 뒤 만든 앱 비밀번호 16자리
# 메일을 보내지 않고 로그로만 보려면 MAIL_MODE=log (인증번호 000000)
MAIL_MODE=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# 카카오 로그인 (카카오 디벨로퍼스 → 앱 키 → REST API 키). redirect URI는 카카오에 등록한 프론트 주소, 쉼표로 구분
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URIS=

# 홈 샘플 카드 → 미리 만든 동화 ("카드id:동화id"를 쉼표로, 예: friend:41,emotion:42). 비우면 샘플 API가 모두 404
SAMPLE_STORIES=

# Spring ↔ AI 내부 토큰 (X-Internal-Token). 새로 만들어도 된다
AI_INTERNAL_TOKEN=

# AI
OPENAI_API_KEY=
IMAGE_CONCURRENCY=3
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# 그림 버킷 (Railway와 같은 버킷). 접근 키는 넣지 않는다 — EC2 IAM 역할
S3_BUCKET=
S3_REGION=ap-northeast-2

# dev: Swagger 켬, 가짜 인증번호 000000은 MAIL_MODE=log일 때만. prod는 Swagger가 꺼진다
SPRING_PROFILES_ACTIVE=dev
