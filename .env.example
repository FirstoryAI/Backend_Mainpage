# docker compose용. .env로 복사해서 쓴다 (.env는 커밋하지 않는다)
# 로컬에 PostgreSQL이 이미 5432를 쓰고 있으면 다른 포트로 바꾼다. application-local.yml의 DB 포트와 맞춘다.
POSTGRES_PORT=55432

# 아래는 앱(Spring)이 읽는 환경 변수다. docker compose는 쓰지 않는다. 운영 배포 환경에 넣는다.
# 로컬은 application.yml 기본값으로 동작하므로 비워 둬도 된다.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
# ALLOWED_ORIGINS=
# REMEMBER_ME_KEY=
# PHONE_AES_KEY=
# PHONE_HMAC_KEY=
# AI_MODE=http
# AI_BASE_URL=
# AI_INTERNAL_TOKEN=
# STORAGE_LOCAL_ROOT=
